# StockPulse Backend Environment Variables
# Copy this file to .env and fill in your values

# Database — SQLite by default, switch to Postgres by changing this URL
DATABASE_URL=sqlite:///./stockpulse.db

# LLM Provider: gemini | groq | ollama
LLM_PROVIDER=gemini

# Your API key — leave blank to use rule-based fallback (still works fine for demos)
LLM_API_KEY=

# Model name (examples: gemini-1.5-flash, llama-3.1-8b-instant, llama3.1)
LLM_MODEL=gemini-1.5-flash

# Base URL for the LLM provider
LLM_BASE_URL=https://generativelanguage.googleapis.com

# Strategy selection: rule | ai  (read fresh on each call, no restart needed)
PRICING_STRATEGY=rule
REORDER_STRATEGY=rule
